# /etc/sniper-dashboard/dashboard.env
# Copy, fill in, chmod 0600, and never commit the filled file.
SUPABASE_URL=https://supabase.example.invalid
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
APP_ORIGIN=https://sniper.example.invalid
DASHBOARD_STORE=supabase
DASHBOARD_AUTH_MODE=supabase
DASHBOARD_HOST_ACTIONS=1
SNIPER_UNIT=discord-sniper.service
SNIPER_RESTART_HELPER=/usr/local/sbin/sniper-restart
SUDO_BIN=/usr/bin/sudo

# Reserved for the deferred secret-at-rest renderer. The current dashboard does
# not read this value; do not rely on it for encryption.
# CONFIG_ENCRYPTION_KEY=replace-with-32-bytes

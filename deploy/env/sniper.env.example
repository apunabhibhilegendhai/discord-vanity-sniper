# /etc/discord-sniper/sniper.env
# Copy, fill in, chmod 0600, and never commit the filled file.
SUPABASE_URL=https://supabase.example.invalid
SUPABASE_SERVICE_ROLE_KEY=replace-me
CONFIG_TABLE=sniper_configs
CONFIG_FILE=/etc/discord-sniper/config.json
# sniper-health publishes $STATE_DIR/config.version as applied_config_version.
STATE_DIR=/opt/discord-sniper/state
REDIS_URL=redis://default:replace-me@127.0.0.1:6379/0
HEALTH_TABLE=sniper_health
HEALTH_INTERVAL=30
SNIPER_UNIT=discord-sniper.service
